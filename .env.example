# ==============================================================================
# Environment Configuration (.env.example)
# ==============================================================================
# FOR LOCAL DEVELOPMENT:
# 1. Copy this file to a new file named `.env`:
#      cp .env.example .env
# 2. Add your actual Gemini API key in place of YOUR_GEMINI_API_KEY.
# 3. Security note: `.env` is in `.gitignore` and is NEVER tracked or committed.
#
# FOR AI STUDIO PLATFORM:
# In the AI Studio runtime, `GEMINI_API_KEY` and `APP_URL` are injected
# automatically into `process.env`. No manual `.env` file is required.
# ==============================================================================

# Gemini AI API Key (required for Gemini AI assistant and vendor quote audit)
# Generate a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Base URL for the application (used for callbacks and links)
# Defaults to http://localhost:3000 for local development
APP_URL="http://localhost:3000"

# Server Port (optional, defaults to 3000)
PORT=3000
