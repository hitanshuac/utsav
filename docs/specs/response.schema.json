{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RebalanceApiResponse",
  "type": "object",
  "required": ["triageTier", "deficit", "strategies", "narrative", "provenance"],
  "properties": {
    "triageTier": {
      "type": "string",
      "enum": ["CRITICAL_OVERRUN", "TIMELINE_BOTTLENECK", "VENDOR_CLARIFICATION", "ON_TRACK"]
    },
    "deficit": {
      "type": "number",
      "minimum": 0
    },
    "narrative": {
      "type": "string"
    },
    "provenance": {
      "type": "string",
      "enum": ["live_ai", "ai", "fallback"]
    },
    "strategies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TradeoffOption"
      }
    }
  },
  "definitions": {
    "TradeoffAdjustment": {
      "type": "object",
      "required": ["category", "delta", "rationale"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["venue", "catering", "decor", "photography", "logistics", "miscellaneous"]
        },
        "delta": { "type": "number" },
        "rationale": { "type": "string" }
      }
    },
    "TradeoffOption": {
      "type": "object",
      "required": ["strategyTitle", "description", "adjustments"],
      "properties": {
        "strategyTitle": { "type": "string" },
        "description": { "type": "string" },
        "adjustments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TradeoffAdjustment"
          }
        }
      }
    },
    "VendorAuditResult": {
      "type": "object",
      "required": ["vendorName", "quotedAmount", "detectedInclusions", "flaggedHiddenCosts", "negotiationQuestions", "provenance"],
      "properties": {
        "vendorName": { "type": "string" },
        "quotedAmount": { "type": "number", "minimum": 0 },
        "detectedInclusions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inclusions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "flaggedHiddenCosts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hiddenCostRisks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "negotiationQuestions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "provenance": {
          "type": "string",
          "enum": ["live_ai", "ai", "fallback"]
        }
      }
    }
  }
}
